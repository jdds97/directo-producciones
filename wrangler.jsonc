{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "directo-producciones-m2-local",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-10-06",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "directo-producciones-cms-local",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "directo-producciones-media-local"
    }
  ],
  "triggers": {
    "crons": ["* * * * *"]
  }
}
