APP_ENV=local
LEADS_ENABLED=false
ANALYTICS_ENABLED=false
# Directorio con facts.yaml y approvers.yaml; por defecto content/ del repo.
# Dejar vacío para usar los registros públicos del repositorio.
CONTENT_REGISTRY_DIR=
# Generar fuera de Git antes de iniciar el panel. No configurar correo/proveedores.
EMDASH_ENCRYPTION_KEY=
