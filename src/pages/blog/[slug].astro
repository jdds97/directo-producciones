---
export const prerender = false;
import { getEmDashEntry } from 'emdash';
import { PortableText } from 'emdash/ui';
import Base from '../../layouts/Base.astro';
import BlogVisual from '../../components/blog/BlogVisual.astro';
import BlogMeta from '../../components/blog/BlogMeta.astro';
import BlogTerms from '../../components/blog/BlogTerms.astro';
import JournalHeading from '../../components/blog/JournalHeading.astro';
import JournalLink from '../../components/blog/JournalLink.astro';
import JournalMedia from '../../components/blog/JournalMedia.astro';
import type { BlogPost } from '../../lib/blog';
import { blogBlockText, blogFilterHref, blogOutline, blogPostHref, blogPublishedAt, blogReadingMinutes, blogUpdatedAt } from '../../lib/blog';
import { getBlogPage } from '../../lib/blog-feed';
import '../../styles/blog-editorial.css';
const { entry, isPreview, error } = await getEmDashEntry<'posts', BlogPost>('posts', Astro.params.slug ?? '');
if (error) throw error;
if (!entry || isPreview) { Astro.response.status = 404; return Astro.rewrite('/404'); }
const post = entry.data;
const category = post.terms?.category?.[0];
const outline = blogOutline(post.content);
// The index only earns its place when the article has enough sections to navigate.
const showOutline = outline.length >= 3;
// Un extracto derivado del primer párrafo no se repite: ese párrafo ya abre la prosa como entradilla.
const flat = (text = '') => text.replace(/…$/, '').replace(/\s+/g, ' ').trim();
const showExcerpt = Boolean(post.excerpt) && !flat((post.content ?? []).slice(0, 3).map(blogBlockText).join(' ')).startsWith(flat(post.excerpt).slice(0, 120));
const related = category ? (await getBlogPage(undefined, 'category', category.slug, 4)).entries.filter(other => other.id !== entry.id).slice(0, 2) : [];
const caption = post.synthetic ? 'Imagen de archivo autorizada usada como ilustración; no identifica un cliente ni un trabajo.' : undefined;
// Metadatos de artículo: fechas reales de publicación/modificación (no la del build) e imagen destacada si existe.
const img = post.featured_image;
const imgSrc = typeof img === 'string' ? img : img?.src || (img?.meta?.storageKey ? `/_emdash/api/media/file/${img.meta.storageKey}` : '');
const modified = blogUpdatedAt(entry);
const slug = Astro.params.slug ?? '';
// Ficha SEO del panel (la lectura por entrada la hidrata): manda sobre el título visible y la entradilla.
const seo = (entry.data as { seo?: { title?: string | null; description?: string | null } }).seo;
---
<Base title={seo?.title?.trim() || post.title} description={seo?.description?.trim() || post.excerpt} type="article"
  image={imgSrc ? { src: imgSrc, width: typeof img === 'object' ? img?.width : undefined, height: typeof img === 'object' ? img?.height : undefined, alt: post.image_alt } : undefined}
  article={{ publishedTime: blogPublishedAt(entry), modifiedTime: modified, author: post.author, section: category?.label }}
  crumbs={[{ name: 'Inicio', path: '/' }, { name: 'Blog', path: '/blog/' }, { name: post.title, path: blogPostHref(slug) }]}>
  <main class="blog-editorial journal-article">
    <nav class="journal-breadcrumb pad" aria-label="Ruta de navegación"><a href="/blog/">Blog</a><span aria-hidden="true">/</span>{category ? <a href={blogFilterHref(category.slug)}>{category.label}</a> : <span>Artículo</span>}</nav>
    <header class:list={['journal-article__header', 'pad', { 'journal-article__header--image': Boolean(post.featured_image) }]}>
      <div class="journal-article__intro">
        <BlogTerms terms={{ category: post.terms?.category ?? [], tag: [] }} />
        <h1>{post.title}</h1>
        {showExcerpt && <p class="journal-excerpt">{post.excerpt}</p>}
        <BlogMeta post={post} publishedAt={blogPublishedAt(entry)} minutes={blogReadingMinutes(post.content)} />
        {post.synthetic && <p class="journal-note"><strong>Entrada de muestra.</strong> Contenido educativo sintético para revisar la plantilla del blog; no describe un trabajo, cliente ni resultado de Directo Producciones.</p>}
      </div>
      {post.featured_image && <BlogVisual image={post.featured_image} imageAlt={post.image_alt} caption={caption} priority />}
    </header>
    <div class="journal-reading pad">
      <aside aria-label="Navegación del artículo">
        {showOutline && <nav class="journal-outline" aria-labelledby="journal-outline-title"><p class="eyebrow" id="journal-outline-title">En este artículo</p><ol>{outline.map(section => <li><a href={`#${section.id}`}>{section.text}</a>{Boolean(section.children.length) && <ol>{section.children.map(child => <li><a href={`#${child.id}`}>{child.text}</a></li>)}</ol>}</li>)}</ol></nav>}
        <a class="journal-link" href="/blog/">← Todas las entradas</a>
      </aside>
      <article class="journal-prose" aria-label="Contenido del artículo">
        <PortableText value={post.content} components={{ type: { image: JournalMedia, gallery: JournalMedia }, block: { h2: JournalHeading, h3: JournalHeading }, mark: { link: JournalLink } }} />
        <footer>
          {Boolean(post.terms?.tag?.length) && <div class="journal-footer-terms"><p class="eyebrow">Etiquetas</p><BlogTerms terms={{ category: [], tag: post.terms!.tag }} /></div>}
          <a class="journal-link" href="/blog/">Volver al blog <span aria-hidden="true">→</span></a>
        </footer>
      </article>
    </div>
    {Boolean(related.length) && <section class="journal-related pad" aria-labelledby="journal-related-title"><h2 id="journal-related-title">Seguir leyendo</h2><ul>{related.map(other => <li><a href={blogPostHref(other.id)}><span class="eyebrow">{other.data.terms?.category?.[0]?.label ?? 'Blog'}</span><strong>{other.data.title}</strong>{other.data.excerpt && <span>{other.data.excerpt}</span>}</a></li>)}</ul></section>}
  </main>
</Base>
