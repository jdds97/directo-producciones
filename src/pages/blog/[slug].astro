---
export const prerender = false;
import { getEmDashEntry } from 'emdash';
import { PortableText } from 'emdash/ui';
import Base from '../../layouts/Base.astro';
import type { BlogPost } from '../../lib/blog';
const { entry, isPreview, error } = await getEmDashEntry<'posts', BlogPost>('posts', Astro.params.slug ?? '');
if (error) throw error;
if (!entry || isPreview) {
  Astro.response.status = 404;
  return Astro.rewrite('/404');
}
---
<Base title={entry.data.title} description={entry.data.excerpt}>
  <main>
    <nav class="breadcrumb pad" aria-label="Ruta de navegación"><a href="/blog/">Blog</a><span>/</span><span>Artículo</span></nav>
    <section class="article-hero pad"><p class="eyebrow">{entry.data.synthetic ? 'Comprobación sintética local' : 'Blog'}</p><h1>{entry.data.title}</h1><p class="blog-meta">{entry.data.author}</p></section>
    <div class="pad"><div class="editorial-art" aria-label="Gráfico editorial conceptual"><span>Blog</span><strong>DIRECTO</strong><span>Directo Producciones</span></div></div>
    <div class="article-layout pad"><nav class="article-toc" aria-label="En este artículo"><strong>En este artículo</strong><a href="#articulo-intro">Introducción</a><a href="#articulo-contenido">Contenido</a><a href="/blog/">Volver al blog</a></nav><article class="article-body"><p id="articulo-intro">{entry.data.excerpt}</p><div id="articulo-contenido"><PortableText value={entry.data.content} /></div><a class="text-link" href="/blog/">Volver al blog <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6" /></svg></a></article></div>
  </main>
</Base>
