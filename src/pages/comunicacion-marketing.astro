---
export const prerender = false;
import Base from '../layouts/Base.astro';
import { visibleFact } from '../lib/facts';
const services = ['service.communication', 'service.digital_marketing'].map(visibleFact).filter(Boolean);
---
<Base title="Comunicación y marketing"><h1>Comunicación y marketing</h1>{services.map(service => service && <p data-fact-id={service.id}>{service.value}</p>)}</Base>
