---
const links = [['/', 'Inicio'], ['/servicios/', 'Servicios'], ['/clientes/', 'Clientes'], ['/quienes-somos/', 'Quiénes somos'], ['/blog/', 'Blog'], ['/contacto/', 'Contacto']];
---
<div class="menu-backdrop" hidden></div>
<nav id="mobile-menu" class="mobile-menu" aria-label="Principal móvil" hidden>
  <div class="menu-top"><span>Directo Producciones</span><button class="menu-close" aria-label="Cerrar menú"><svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="m6 6 12 12M6 18 18 6" /></svg></button></div>
  {links.map(([href,label]) => <a href={href} aria-current={Astro.url.pathname === href ? 'page' : undefined}>{label}</a>)}
</nav>
