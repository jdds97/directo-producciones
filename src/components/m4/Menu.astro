---
import { isCurrentPage } from "../../lib/site-navigation";
import { getNavigation } from "../../lib/site-content";
import SocialLinks from "./SocialLinks.astro";
const navigationItems = await getNavigation();
---
<div class="menu-backdrop" hidden></div>
<nav id="mobile-menu" class="mobile-menu" aria-label="Navegación principal" hidden>
  <div class="menu-top"><span>Directo Producciones</span><button class="menu-close" aria-label="Cerrar menú"><svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="m6 6 12 12M6 18 18 6" /></svg></button></div>
  {navigationItems.map(item => (
    <a href={item.href} aria-current={isCurrentPage(Astro.url.pathname, item) ? "page" : undefined}>{item.label}</a>
  ))}
  <SocialLinks class="menu-socials" />
</nav>
