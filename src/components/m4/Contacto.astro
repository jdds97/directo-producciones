---
import { draftCopy } from "../../lib/m4-draft";

const copy = draftCopy("Contacto");

---
<main><section class="page-hero pad"><div><p class="eyebrow">{copy["t001"]}</p><h1>{copy["t002"]}<br />{copy["t003"]}</h1></div><div class="page-intro"><p>{copy["t004"]}</p></div></section><section class="contact-layout pad"><div class="contact-methods"><div class="contact-method"><svg aria-hidden="true" class="icon" viewBox="0 0 24 24"><path d="M22 16.9v3a2 2 0 0 1-2.2 2A19.8 19.8 0 0 1 3.1 5.2 2 2 0 0 1 5.1 3h3a2 2 0 0 1 2 1.7c.1 1 .4 2 .8 3a2 2 0 0 1-.5 2.1L9.1 11a16 16 0 0 0 3.9 3.9l1.3-1.3a2 2 0 0 1 2.1-.5c1 .4 2 .7 3 .8a2 2 0 0 1 1.7 2Z"></path></svg><h2>{copy["t005"]}</h2><span>{copy["t006"]}</span></div><div class="contact-method"><svg aria-hidden="true" class="icon" viewBox="0 0 24 24"><path d="M21 11.5a8.4 8.4 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.4 8.4 0 0 1-3.8-.9L3 21l1.9-5.7a8.4 8.4 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.4 8.4 0 0 1 3.8-.9h.5a8.5 8.5 0 0 1 8 8v.5Z"></path></svg><h2>{copy["t007"]}</h2><span>{copy["t008"]}</span></div><div class="contact-method"><svg aria-hidden="true" class="icon" viewBox="0 0 24 24"><rect height="14" rx="2" width="18" x="3" y="5"></rect><path d="m3 7 9 6 9-6"></path></svg><h2>{copy["t009"]}</h2><span>{copy["t010"]}</span></div></div><form class="contact-form" novalidate="" data-disabled-form="" aria-describedby="contact-status" autocomplete="off"><h2>{copy["t011"]}</h2><div class="field-grid"><div class="field"><label for="name">{copy["t012"]}</label><input autocomplete="off" id="name" placeholder={copy["t013"]} /></div><div class="field"><label for="email">{copy["t014"]}</label><input autocomplete="off" id="email" placeholder={copy["t015"]} type="email" /></div></div><div class="field-grid"><div class="field"><label for="phone">{copy["t016"]}</label><input autocomplete="off" id="phone" placeholder={copy["t017"]} type="tel" /></div><div class="field"><label for="company">{copy["t018"]}</label><input autocomplete="off" id="company" placeholder={copy["t019"]} /></div></div><div class="field"><label for="service">{copy["t020"]}</label><select id="service" autocomplete="off"><option>{copy["t021"]}</option><option>{copy["t022"]}</option><option>{copy["t023"]}</option></select></div><div class="field"><label for="message">{copy["t024"]}</label><textarea id="message" placeholder={copy["t025"]} autocomplete="off"></textarea><p class="help">{copy["t026"]}</p></div><label class="check-label"><input type="checkbox" autocomplete="off" /><span>{copy["t027"]}<a href="/privacidad/">{copy["t028"]}</a>{copy["t029"]}</span></label><button class="button primary" type="button" disabled="" aria-describedby="contact-status">{copy["t030"]}<svg aria-hidden="true" class="icon" viewBox="0 0 24 24"><path d="M7 17 17 7M7 7h10v10"></path></svg></button><p class="form-status" role="status" id="contact-status">{copy["t031"]}</p></form></section></main>
