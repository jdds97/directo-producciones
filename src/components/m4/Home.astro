---
import { pageHref } from "../../lib/site-navigation";
import { getProjects, getTeam, pageCopy, pageImages, pageVideo } from "../../lib/site-content";
import { imgAttrs } from "../../lib/media";
import { publicContact } from "../../lib/facts";
// «Trabajos recientes»: los proyectos marcados para Inicio. Con la lista vacía la sección no se pinta.
const m4PortfolioProjects = await getProjects("home");
const copy = await pageCopy("Home");
const photo = await pageImages("page_home");
// Vídeo de portada editable (subido al panel o el del sitio) con su versión móvil opcional.
const hero = await pageVideo("page_home", "hero_video", "hero_video_movil");

const team = await getTeam("home");
// Teléfono de llamada directa: el mismo hecho que la página de Contacto (en producción, solo aprobado; si no, sin enlace «Llamar»).
const { phone } = publicContact();
import ClientBand from "./ClientBand.astro";
import ContactForm from "./ContactForm.astro";
import WhatsAppAccess from "./WhatsAppAccess.astro";
import "../../styles/home-experience.css";
import "../../styles/home-about-editorial.css";

const cameraMeterBars = Array.from({ length: 19 }, (_, index) => index);
---

<main id="inicio" class="home-experience" data-home-experience>
  <section class="home-hero" aria-labelledby="home-hero-title" data-home-hero>
    <div class="home-hero-stage" data-home-hero-stage>
      <div class="home-hero-visual" id="home-hero-media" data-home-hero-visual>
        <video
          data-home-video
          data-home-video-src={hero.src}
          data-home-video-mobile-src={hero.mobileSrc}
          poster={photo.hero_poster.src}
          muted
          playsinline
          loop
          preload="none"
          aria-hidden="true"
        ></video>
        <div class="home-hero-center-logo" data-home-hero-center-logo aria-hidden="true">
          <img
            src="/assets/m4/logo-white.svg"
            alt=""
            width="120"
            height="120"
            loading="eager"
          />
        </div>
      </div>
      <div class="home-camera-ui" aria-hidden="true">
        <span class="home-camera-corner home-camera-corner--tl"></span>
        <span class="home-camera-corner home-camera-corner--tr"></span>
        <span class="home-camera-corner home-camera-corner--bl"></span>
        <span class="home-camera-corner home-camera-corner--br"></span>
        <span class="home-camera-safe"></span>
        <span class="home-camera-rec">
          <span class="home-camera-rec-dot"></span>REC
        </span>
        <span class="home-camera-info">MF</span>
        <span class="home-camera-preview">ENG / PREVIEW</span>
        <svg class="home-camera-focus" viewBox="0 0 240 160" fill="none">
          <path d="M32 1H1v31m207-31h31v31M1 128v31h31m176 0h31v-31M110 80h20m-10-10v20" />
        </svg>
        <span class="home-camera-audio">
          <span>CH L</span>
          <svg class="home-camera-meter home-camera-meter--left" viewBox="0 0 96 8" aria-hidden="true">
            {cameraMeterBars.map((index) => (
              <rect
                class="home-camera-meter-bar"
                data-active="false"
                data-peak="false"
                x={index * 5}
                y="0"
                width="3"
                height="8"
              />
            ))}
          </svg>
          <span>CH R</span>
          <svg class="home-camera-meter home-camera-meter--right" viewBox="0 0 96 8" aria-hidden="true">
            {cameraMeterBars.map((index) => (
              <rect
                class="home-camera-meter-bar"
                data-active="false"
                data-peak="false"
                x={index * 5}
                y="0"
                width="3"
                height="8"
              />
            ))}
          </svg>
        </span>
      </div>

      <div class="home-hero-content">
        <p class="home-eyebrow">{copy.hero_eyebrow}</p>
        <h1 id="home-hero-title">
          {copy.hero_linea_1}<br />
          {copy.hero_linea_2}<br />
          {copy.hero_linea_3}
        </h1>
        <p class="home-hero-copy">
          {copy.hero_entradilla}
        </p>
        <nav class="home-hero-actions" aria-label="Explorar nuestras líneas de trabajo">
          <a class="home-hero-link" href={pageHref("produccion")}>{copy.hero_cta_prod}</a>
          <a class="home-hero-link" href={pageHref("comunicacion")}>{copy.hero_cta_com}</a>
        </nav>
      </div>
      <button
        class="home-media-toggle home-hero-toggle"
        type="button"
        data-home-video-toggle
        aria-controls="home-hero-media"
        aria-pressed="false"
        aria-label="Pausar o reproducir el vídeo de portada"
        hidden
      >
        <svg aria-hidden="true" viewBox="0 0 24 24">
          <path d="M9 5v14m6-14v14"></path>
        </svg>
        <span>Vídeo de portada</span>
      </button>
      <p class="home-hero-scroll-cue">
        <span>Sigue bajando</span>
        <svg viewBox="0 0 16 24" aria-hidden="true">
          <path d="M8 3v17m-5-5 5 5 5-5"></path>
        </svg>
      </p>
    </div>
  </section>

  <section class="home-about" data-home-about aria-labelledby="home-about-title">
    <div class="home-about-inner">
      <header class="home-introduction" data-home-reveal>
        <p class="home-eyebrow"><span aria-hidden="true">01 / </span>{copy.pres_eyebrow}</p>
        <h2 id="home-about-title">{copy.pres_titulo}</h2>
        <p class="home-section-subtitle">{copy.pres_entradilla}</p>
      </header>
      <div class="home-introduction-foot">
        <div class="home-introduction-note" data-home-reveal data-home-reveal-delay="100">
          <p class="home-introduction-statement">
            Trabajamos en <a href={pageHref("produccion")} data-fact-id="service.production_scope_review">producción audiovisual</a>,
            <a href={pageHref("comunicacion")} data-fact-id="service.communication">comunicación y <span data-fact-id="service.digital_marketing">marketing</span></a>.
          </p>
          <p>{copy.pres_perfiles}</p>
          <a class="home-introduction-link" href={pageHref("quienes-somos")}>
            {copy.pres_enlace}
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17 17 7M7 7h10v10" /></svg>
          </a>
        </div>
        <figure class="home-communication-mark" aria-label="Comunicación y marketing: prensa, redes y web" data-fact-id="service.communication" data-home-reveal data-home-reveal-delay="160">
          <svg viewBox="0 0 440 264" aria-hidden="true">
            <g class="home-communication-piece home-communication-piece--web">
              <g transform="rotate(4 286 100)">
                <rect class="home-communication-paper" x="166" y="18" width="248" height="166" rx="4" />
                <path class="home-communication-rule" d="M166 48h248" />
                <circle class="home-communication-ink" cx="181" cy="33" r="2" />
                <circle class="home-communication-muted" cx="190" cy="33" r="2" />
                <circle class="home-communication-muted" cx="199" cy="33" r="2" />
                <text class="home-communication-small" x="374" y="37">Web</text>
                <g class="home-communication-web-visual">
                  <rect class="home-communication-tint" x="182" y="64" width="96" height="103" />
                  <path class="home-communication-rule" d="M194 149l26-48 19 28 13-17 14 37z" />
                  <circle class="home-communication-ink" cx="255" cy="85" r="5" />
                </g>
                <path class="home-communication-copy home-communication-copy--web" pathLength="1" d="M294 76h100m-100 10h83m-83 25h94m-94 8h94m-94 8h65" />
              </g>
            </g>
            <g class="home-communication-piece home-communication-piece--press">
              <g transform="rotate(-7 106 138)">
                <rect class="home-communication-paper" x="28" y="42" width="156" height="196" />
                <text class="home-communication-small" x="44" y="67">PRENSA</text>
                <path class="home-communication-rule" d="M44 79h124" />
                <text class="home-communication-title" x="44" y="110">Nota de</text>
                <text class="home-communication-title" x="44" y="136">prensa</text>
                <path class="home-communication-copy home-communication-copy--press" pathLength="1" d="M44 157h124m-124 8h124m-124 8h98m-98 16h124m-124 8h124m-124 8h86" />
                <path class="home-communication-rule" d="M44 222h24" />
              </g>
            </g>
            <g class="home-communication-piece home-communication-piece--social">
              <g transform="rotate(-4 312 176)">
                <rect class="home-communication-ink" x="236" y="102" width="152" height="148" rx="4" />
                <text class="home-communication-reverse home-communication-small" x="252" y="127">REDES</text>
                <circle class="home-communication-reverse home-communication-status" cx="370" cy="122" r="3" />
                <path class="home-communication-crop" pathLength="1" d="M252 154v-10h10m100 0h10v10m0 54v10h-10m-100 0h-10v-10" />
                <text class="home-communication-reverse home-communication-title home-communication-publish" x="268" y="189">Directo.</text>
                <path class="home-communication-crop" pathLength="1" d="M252 234h38m8 0h12" />
              </g>
            </g>
          </svg>
        </figure>
      </div>
    </div>
  </section>

  {m4PortfolioProjects.length !== 0 && (
  <section class="home-gallery" id="portfolio" aria-labelledby="home-gallery-title" data-home-gallery>
    <header class="home-section-heading">
      <div>
        <p class="home-eyebrow"><span aria-hidden="true">02 / </span>{copy.port_eyebrow}</p>
        <h2 class="home-gallery-heading" id="home-gallery-title">{copy.port_titulo}</h2>
        <p class="home-section-subtitle">{copy.port_entradilla}</p>
      </div>
      <nav class="home-gallery-controls" aria-label="Controles de trabajos recientes">
        <button
          class="home-gallery-control"
          type="button"
          data-home-gallery-prev
          aria-label="Trabajo anterior"
          hidden
        >
          <svg aria-hidden="true" viewBox="0 0 24 24"><path d="m15 18-6-6 6-6"></path></svg>
        </button>
        <button
          class="home-gallery-control"
          type="button"
          data-home-gallery-toggle
          aria-label="Pausar movimiento"
          aria-pressed="false"
          hidden
        >
          <svg data-home-gallery-toggle-icon aria-hidden="true" viewBox="0 0 24 24">
            <path d="M9 5v14m6-14v14"></path>
          </svg>
        </button>
        <button
          class="home-gallery-control"
          type="button"
          data-home-gallery-next
          aria-label="Trabajo siguiente"
          hidden
        >
          <svg aria-hidden="true" viewBox="0 0 24 24"><path d="m9 18 6-6-6-6"></path></svg>
        </button>
      </nav>
    </header>

    <div
      class="home-gallery-viewport"
      data-home-gallery-viewport
      role="region"
      aria-labelledby="home-gallery-title"
      tabindex="0"
    >
      <div class="home-gallery-track" data-home-gallery-track>
        {m4PortfolioProjects.map((project, index) => (
          <figure
            class={`home-gallery-panel home-gallery-panel--${project.homeKind} home-gallery-panel--${project.homeSize}`}
            data-home-gallery-panel
            data-home-gallery-kind={project.homeKind}
            tabindex="0"
          >
            <div class="home-gallery-media" data-home-gallery-media aria-hidden="true">
              <img
                src={project.poster}
                alt=""
                width={project.width}
                height={project.height}
                loading="lazy"
              />
              <video
                data-home-video
                data-home-video-src={project.videoSrc}
                data-home-video-mobile-src={project.mobileVideoSrc}
                data-poster={project.poster}
                muted
                playsinline
                loop
                preload="none"
                aria-hidden="true"
              ></video>
              <span class="home-gallery-mask" data-home-gallery-mask aria-hidden="true"></span>
            </div>
            <figcaption>
              <span class="home-gallery-index" aria-hidden="true">({String(index + 1).padStart(2, '0')})</span>
              <div class="home-gallery-info">
                <span class="home-gallery-title">{project.title}</span>
                <span class="home-gallery-context">{project.context}</span>
              </div>
              <p class="home-gallery-description">
                {project.description}
              </p>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>

    <nav class="home-gallery-bar" aria-label="Navegación de portfolio y servicios">
      <a class="home-gallery-bar-link home-gallery-bar-link--start" href={pageHref("portfolio")}>
        <span class="home-gallery-bar-icon" aria-hidden="true">←</span>
        <span>{copy.port_ver_todos}</span>
      </a>
      <a class="home-gallery-bar-link home-gallery-bar-link--end" href={pageHref("produccion")}>
        <span>{copy.port_ver_servicios}</span>
        <span class="home-gallery-bar-icon" aria-hidden="true">→</span>
      </a>
    </nav>
  </section>
  )}

  <section class="home-services" id="lineas" data-home-services aria-labelledby="home-services-title">
    <div class="home-services-stage" data-home-services-stage>
      <div class="home-services-intro" data-service-reveal="stagger">
        <p class="home-eyebrow"><span aria-hidden="true">03 / </span>{copy.serv_eyebrow}</p>
        <h2 id="home-services-title">{copy.serv_titulo}</h2>
        <p class="home-section-subtitle">{copy.serv_entradilla}</p>
      </div>

      <div class="home-services-layout">
      <div class="home-service-panels">
        <article class="home-service-panel" id="home-service-streaming" data-home-service-panel>
          <figure class="home-service-visual" data-service-reveal="photo">
            <img {...imgAttrs(photo.serv_1_foto)} />
          </figure>
          <div class="home-service-copy" data-service-reveal="stagger">
            <span class="home-service-number" aria-hidden="true">01</span>
            <h3>{copy.serv_1_titulo}</h3>
            <p>{copy.serv_1_texto}</p>
            <a class="home-text-link" href={pageHref("produccion")}>Producción</a>
          </div>
        </article>

        <article class="home-service-panel" id="home-service-audiovisual" data-home-service-panel>
          <figure class="home-service-visual" data-service-reveal="photo">
            <img {...imgAttrs(photo.serv_2_foto)} />
          </figure>
          <div class="home-service-copy" data-service-reveal="stagger">
            <span class="home-service-number" aria-hidden="true">02</span>
            <h3>{copy.serv_2_titulo}</h3>
            <p>
              {copy.serv_2_texto}
            </p>
            <a class="home-text-link" href={pageHref("produccion")}>Producción</a>
          </div>
        </article>

        <article class="home-service-panel" id="home-service-programas" data-home-service-panel>
          <figure class="home-service-visual" data-service-reveal="photo">
            <img {...imgAttrs(photo.serv_3_foto, { sizes: "(max-width: 767px) 92vw, 45vw" })} />
          </figure>
          <div class="home-service-copy" data-service-reveal="stagger">
            <span class="home-service-number" aria-hidden="true">03</span>
            <h3>{copy.serv_3_titulo}</h3>
            <p>
              {copy.serv_3_texto}
            </p>
            <a class="home-text-link" href={pageHref("produccion")}>Producción</a>
          </div>
        </article>

        <article class="home-service-panel" id="home-service-comunicacion" data-home-service-panel>
          <figure class="home-service-visual" data-service-reveal="photo">
            <img {...imgAttrs(photo.serv_4_foto, { sizes: "(max-width: 767px) 92vw, 40vw" })} />
          </figure>
          <div class="home-service-copy" data-service-reveal="stagger">
            <span class="home-service-number" aria-hidden="true">04</span>
            <h3>{copy.serv_4_titulo}</h3>
            <p>
              {copy.serv_4_texto}
            </p>
            <a class="home-text-link" href={pageHref("comunicacion")}>Comunicación</a>
          </div>
        </article>
      </div>

      <nav class="home-service-controls" data-home-service-controls aria-label="Seleccionar servicio" hidden>
        <button type="button" data-home-service aria-controls="home-service-streaming" aria-pressed="false">
          <span aria-hidden="true">(01)</span><span>Streaming de eventos</span>
        </button>
        <button type="button" data-home-service aria-controls="home-service-audiovisual" aria-pressed="false">
          <span aria-hidden="true">(02)</span><span>Producción audiovisual</span>
        </button>
        <button type="button" data-home-service aria-controls="home-service-programas" aria-pressed="false">
          <span aria-hidden="true">(03)</span><span>Programas de televisión</span>
        </button>
        <button type="button" data-home-service aria-controls="home-service-comunicacion" aria-pressed="false">
          <span aria-hidden="true">(04)</span><span>Comunicación integral</span>
        </button>
      </nav>
      </div>
    </div>
  </section>

  <section class="home-contact" id="contacto" aria-labelledby="home-contact-title">
    <div class="home-contact-layout">
      <div class="home-contact-people">
        <div class="home-contact-heading">
          <p class="home-eyebrow"><span aria-hidden="true">04 / </span>{copy.cont_eyebrow}</p>
          <h2 id="home-contact-title" data-home-reveal>{copy.cont_titulo}</h2>
        </div>

        <div class="home-team">
          {team.map((person) => (
            <figure class="home-person">
              <div class="home-person-portrait" data-service-reveal="photo">
                {person.photo && <img {...imgAttrs(person.photo, { sizes: "(max-width: 767px) 38vw, 205px", width: 205, height: 205 })} />}
              </div>
              <figcaption>
                <strong>{person.name}</strong>
                <span class="home-person-role">{person.role}</span>
                {person.email && <a class="home-person-email" href={`mailto:${person.email}`} data-fact-id={person.emailFact}>{person.email}</a>}
              </figcaption>
            </figure>
          ))}
        </div>

        <address class="home-contact-details">
          {phone && (
            <a class="home-contact-call" href={`tel:+34${phone.digits}`}>
              <svg aria-hidden="true" class="icon" viewBox="0 0 24 24"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.4 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2Z" /></svg>
              <span>Llamar · {phone.display}</span>
            </a>
          )}
          <WhatsAppAccess variant="links" />
        </address>
      </div>

      <ContactForm variant="home" />
    </div>
  </section>

  <ClientBand />
</main>

<noscript>
  <style is:inline>
    .home-experience { --home-hero-progress: 1; }
    .home-hero-content { pointer-events: auto; transition: none; }
    .home-hero { height: auto; min-height: 100svh; }
    .home-hero-stage { position: relative; }
    .home-hero-visual { transform: none; clip-path: none; }
  </style>
</noscript>
