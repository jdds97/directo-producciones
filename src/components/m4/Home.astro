---
import { draftCopy } from "../../lib/m4-draft";
import ClientBand from "./ClientBand.astro";
import Metrics from "./Metrics.astro";
import ProjectCTA from "./ProjectCTA.astro";
import SignalFlow from "./SignalFlow.astro";
import Testimonials from "./Testimonials.astro";

const copy = draftCopy("Home");

---
<main id="inicio">
<section class="hero"><div class="hero-intro pad"><div class="hero-main" data-enter="0"><p class="eyebrow"><span class="rule"></span>{copy["t001"]}</p><h1 class="home-title"><span>{copy["t002"]}</span><span>{copy["t003"]}</span><span>{copy["homeH1Line3"]}</span></h1></div><div class="hero-copy" data-enter="80"><p>{copy["t004"]}</p><a class="button primary hero-line-cta" href="/streaming/">{copy["t005"]}<svg class="icon arrow" aria-hidden="true" viewBox="0 0 24 24"><path d="M7 17 17 7M7 7h10v10"></path></svg></a><a class="button primary hero-line-cta" href="/comunicacion-marketing/">{copy["t006"]}<svg class="icon" aria-hidden="true" viewBox="0 0 24 24"><path d="M7 17 17 7M7 7h10v10"></path></svg></a></div></div>
<SignalFlow /></section>
<ClientBand />
<section class="streaming pad section" id="streaming"><div class="section-head"><div><p class="eyebrow">{copy["t007"]}</p><h2>{copy["t008"]}<br />{copy["t009"]}</h2></div><div class="section-aside"><p>{copy["t010"]}<br />{copy["t011"]}<br />{copy["t012"]}</p><p class="secondary">{copy["t013"]}</p></div></div><div class="format-list"><div class="format-row"><div class="format-index">{copy["t014"]}</div><h3>{copy["t015"]}<br />{copy["t016"]}</h3><p>{copy["t017"]}</p><a href="/servicios/#servicios-streaming" class="format-detail" aria-label={copy["t018"]}>{copy["t019"]}<svg class="icon" aria-hidden="true" viewBox="0 0 24 24"><path d="M7 17 17 7M7 7h10v10"></path></svg></a></div><div class="format-row"><div class="format-index">{copy["t020"]}</div><h3>{copy["t021"]}</h3><p>{copy["t022"]}</p><a href="/servicios/#tv-online" class="format-detail" aria-label={copy["t023"]}>{copy["t024"]}<svg class="icon" aria-hidden="true" viewBox="0 0 24 24"><path d="M7 17 17 7M7 7h10v10"></path></svg></a></div></div></section>
<Metrics />
<section class="process section pad" id="proceso"><div class="section-head"><div><p class="eyebrow">{copy["t025"]}</p><h2>{copy["t026"]}<br />{copy["t027"]}</h2></div><p class="section-aside">{copy["t028"]}</p></div><div class="process-list"><div class="process-row"><span class="step-number">{copy["t029"]}</span><h3>{copy["t030"]}</h3><p>{copy["t031"]}</p></div><div class="process-row"><span class="step-number">{copy["t032"]}</span><h3>{copy["t033"]}</h3><p>{copy["t034"]}</p></div><div class="process-row"><span class="step-number">{copy["t035"]}</span><h3>{copy["t036"]}</h3><p>{copy["t037"]}</p></div></div><a class="text-link" href="#contacto">{copy["t038"]}<svg class="icon arrow" aria-hidden="true" viewBox="0 0 24 24"><path d="M7 17 17 7M7 7h10v10"></path></svg></a></section>
<Testimonials />
<section class="communication section pad" id="comunicacion"><div class="communication-title"><p class="eyebrow">{copy["t039"]}</p><h2>{copy["t040"]}<br />{copy["t041"]}</h2></div><div class="communication-copy"><p>{copy["t042"]}</p><div class="service-line"><span>{copy["t043"]}</span><svg class="icon" aria-hidden="true" viewBox="0 0 24 24"><path d="M5 12h14m-6-6 6 6-6 6"></path></svg></div><div class="service-line"><span>{copy["t044"]}</span><svg class="icon" aria-hidden="true" viewBox="0 0 24 24"><path d="M5 12h14m-6-6 6 6-6 6"></path></svg></div><a class="text-link" href="#contacto">{copy["t045"]}<svg class="icon arrow" aria-hidden="true" viewBox="0 0 24 24"><path d="M7 17 17 7M7 7h10v10"></path></svg></a></div></section>
<ProjectCTA />
</main>
