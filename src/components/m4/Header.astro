---
import { draftCopy } from "../../lib/m4-draft";

const copy = draftCopy("Header");

---
<header class="header"><a class="brand" href="/" aria-label={copy["t001"]}><img class="brand-logo brand-logo-blue" src="/assets/m4/logo-original.jpg" alt={copy["t002"]} width="96" height="96" /><img class="brand-logo brand-logo-white" src="/assets/m4/logo-white.svg" alt={copy["t003"]} width="96" height="96" /></a><nav class="desktop-nav" aria-label={copy["t004"]}><a href="/" class:list={{active: Astro.url.pathname === "/"}} aria-current={Astro.url.pathname === "/" ? "page" : undefined}>{copy["t005"]}</a><a href="/servicios/" class:list={{active: Astro.url.pathname.startsWith("/servicios/")}} aria-current={Astro.url.pathname.startsWith("/servicios/") ? "page" : undefined}>{copy["t006"]}</a><a href="/clientes/" class:list={{active: Astro.url.pathname.startsWith("/clientes/")}} aria-current={Astro.url.pathname.startsWith("/clientes/") ? "page" : undefined}>{copy["t007"]}</a><a href="/quienes-somos/" class:list={{active: Astro.url.pathname.startsWith("/quienes-somos/")}} aria-current={Astro.url.pathname.startsWith("/quienes-somos/") ? "page" : undefined}>{copy["t008"]}</a><a href="/blog/" class:list={{active: Astro.url.pathname.startsWith("/blog/")}} aria-current={Astro.url.pathname.startsWith("/blog/") ? "page" : undefined}>{copy["t009"]}</a></nav><a class="contact-nav" href="/contacto/">{copy["t010"]}<svg class="icon" aria-hidden="true" viewBox="0 0 24 24"><path d="M7 17 17 7M7 7h10v10"></path></svg></a><button class="theme-toggle" type="button" aria-label={copy["t011"]} aria-pressed="false">{copy["t012"]}</button><button class="menu-toggle" aria-label={copy["t013"]} aria-expanded="false" aria-controls="mobile-menu"><svg class="icon" aria-hidden="true" viewBox="0 0 24 24"><path d="M4 8h16M4 16h16"></path></svg></button></header>
