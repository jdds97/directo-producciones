---
import { pageCopy } from "../../lib/site-content";
import { pageHref } from "../../lib/site-navigation";
import { approvedFact } from "../../lib/facts";
import PageHero from "./PageHero.astro";
import ProjectCTA from "./ProjectCTA.astro";
import "../../styles/services-editorial.css";
const copy = await pageCopy("PreguntasFrecuentes");
// Diseño fijo (D-49): grupos, orden y destinos en código; el texto, en el CMS. Claves literales: el guard busca cada tNNN aquí.
// data-fact-id ata cada respuesta a su hecho aprobado (el guard lo comprueba). C4 remite al botón global de WhatsApp: sin ese hecho, el botón no se pinta y la pregunta tampoco.
const whatsapp = approvedFact("contact.whatsapp_secondary_phone");
const groups = [
  { id: "streaming-produccion", fact: "service.production_scope_review", title: "t005", qa: [["t006", "t007"], ["t008", "t009"], ["t010", "t011"], ["t012", "t013"]], link: { href: pageHref("produccion"), label: "t014" } },
  { id: "comunicacion-marketing", fact: "service.communication", title: "t015", qa: [["t016", "t017", "service.digital_marketing"]], link: { href: pageHref("comunicacion"), label: "t018" } },
  { id: "contratacion-contacto", title: "t019", qa: [["t020", "t021"], ["t022", "t023"], ["t024", "t025"], ...(whatsapp ? [["t026", "t027", whatsapp.id]] : [])], link: { href: pageHref("quienes-somos"), label: "t028" } },
];
---
<main class="services-page">
  <PageHero eyebrow={copy["t001"]} id="faq-title"><Fragment slot="title">{copy["t002"]}<br />{copy["t003"]}</Fragment><p>{copy["t004"]}</p></PageHero>
  {groups.map((group, index) => (
    <section class="services-block services-faq" id={group.id} aria-labelledby={`${group.id}-title`} data-fact-id={group.fact}>
      <header class="services-section-head">
        <div><p class="eyebrow" aria-hidden="true">{String(index + 1).padStart(2, "0")} /</p><h2 id={`${group.id}-title`}>{copy[group.title]}</h2></div>
        <a class="text-link" href={group.link.href}>{copy[group.link.label]}<svg class="icon arrow" aria-hidden="true" viewBox="0 0 24 24"><path d="M7 17 17 7M7 7h10v10"></path></svg></a>
      </header>
      <div class="services-faq-list">{group.qa.map(([q, a, fact]) => <details data-fact-id={fact}><summary>{copy[q]}</summary><p>{copy[a]}</p></details>)}</div>
    </section>
  ))}
  <ProjectCTA />
</main>
