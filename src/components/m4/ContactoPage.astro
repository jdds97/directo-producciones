---
import { getTeam, pageCopy, pageImages } from "../../lib/site-content";
import { imgAttrs } from "../../lib/media";
import { publicContact } from "../../lib/facts";
import ContactForm from "./ContactForm.astro";
import WhatsAppAccess from "./WhatsAppAccess.astro";
import Icon from "./Icon.astro";
import SocialLinks from "./SocialLinks.astro";

const copy = await pageCopy("Contacto");
const photo = await pageImages("page_contacto");
// Contactos directos: los mismos perfiles, fotos y correos (hechos aprobados) que «Hablemos de tu proyecto» en Inicio.
const team = await getTeam("home");
// Teléfono y correo del registro de hechos: en producción solo si están aprobados; si no, se omite el acceso.
const { phone, email } = publicContact();
---

<main>
  <section class="m4-hero m4-hero--contact" aria-labelledby="contact-title">
    <div class="m4-hero__inner">
      <div class="m4-hero__copy">
        <p class="eyebrow">{copy["t001"]}</p>
        <h1 id="contact-title">{copy["t002"]}<br />{copy["t003"]}</h1>
        <div class="m4-hero__lede"><p>{copy["t004"]}</p></div>
      </div>
      <figure class="m4-hero__media">
        <img {...imgAttrs(photo.hero_foto, { priority: true, sizes: "(max-width: 1000px) 100vw, 40vw" })} />
        <div class="m4-visor" aria-hidden="true"><i class="m4-frame-c m4-frame-c--tl"></i><i class="m4-frame-c m4-frame-c--tr"></i><i class="m4-frame-c m4-frame-c--bl"></i><i class="m4-frame-c m4-frame-c--br"></i><span class="m4-visor__rec">REC</span></div>
      </figure>
      <div class="contact-strip">
        {email && <div class="contact-strip__item contact-strip__item--mail">
          <p><svg aria-hidden="true" class="icon" viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3 6 9 7 9-7" /></svg>{copy["t009"]}</p>
          <a href={`mailto:${email}`}>{email}</a>
        </div>}
        {phone && <div class="contact-strip__item">
          <p><svg aria-hidden="true" class="icon" viewBox="0 0 24 24"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.4 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2Z" /></svg>{copy["t005"]}</p>
          <a href={`tel:+34${phone.digits}`}>{phone.display}</a>
        </div>}
        <div class="contact-strip__item">
          <p><Icon name="whatsapp" class="icon" />WhatsApp</p>
          <WhatsAppAccess variant="links" labeled={false} icon={false} />
        </div>
      </div>
    </div>
  </section>
  <section class="contact-layout pad">
    <div class="contact-side">
      <section class="contact-team" aria-labelledby="contact-team-title">
        <h2 id="contact-team-title">Contacto directo con el equipo</h2>
        <ul class="contact-team__list">
          {team.map((person) => (
            <li class="contact-person">
              <div class="contact-person__photo">
                {person.photo && <img {...imgAttrs(person.photo, { sizes: "(max-width: 767px) 72px, 112px", width: 112, height: 140 })} />}
              </div>
              <div class="contact-person__text">
                <h3>{person.name}</h3>
                <p>{person.role}</p>
                {person.email && <a href={`mailto:${person.email}`} data-fact-id={person.emailFact}>{person.email.split("@")[0]}@<wbr />{person.email.split("@")[1]}</a>}
              </div>
            </li>
          ))}
        </ul>
      </section>
      <SocialLinks class="contact-socials" />
    </div>
    <ContactForm variant="page" />
  </section>
</main>

<style>
  .contact-side { display: grid; align-content: start; gap: 32px; min-width: 0; }
  /* Contactos directos: ficha de cada responsable con retrato, cargo y correo, alineada con el formulario. */
  .contact-team h2 { font-size: 30px; line-height: 36px; letter-spacing: -.03em; text-wrap: balance; }
  .contact-team__list { display: grid; margin: 24px 0 0; padding: 0; list-style: none; border-top: 1px solid var(--line); }
  .contact-person { display: grid; grid-template-columns: 112px minmax(0, 1fr); align-items: center; gap: 24px; padding: 24px 0; border-bottom: 1px solid var(--line); }
  .contact-person__photo { aspect-ratio: 4 / 5; overflow: hidden; background: var(--tint); }
  .contact-person__photo img { display: block; width: 100%; height: 100%; object-fit: cover; object-position: 50% 15%; }
  .contact-person__text { display: grid; gap: 4px; min-width: 0; }
  .contact-person h3 { font-size: 20px; line-height: 28px; font-weight: 700; letter-spacing: -.02em; }
  .contact-person p { color: var(--secondary); font-size: 14px; line-height: 20px; }
  .contact-person a { display: inline-flex; align-items: center; width: fit-content; max-width: 100%; min-height: 44px; color: var(--main); font-size: 16px; font-weight: 600; line-height: 24px; text-decoration: underline; text-decoration-color: rgb(22 78 99 / 40%); text-underline-offset: 4px; transition: text-decoration-color 160ms var(--ease); }
  .contact-person a:hover { text-decoration-color: currentColor; }
  .contact-socials { color: var(--main); }
  @container (max-width: 767px) {
    .contact-team h2 { font-size: 24px; line-height: 32px; }
    .contact-team__list { margin-top: 16px; }
    .contact-person { grid-template-columns: 72px minmax(0, 1fr); gap: 16px; padding: 16px 0; }
    .contact-person h3 { font-size: 18px; line-height: 28px; }
    .contact-person a { font-size: 14px; line-height: 20px; }
  }
  /* Franja de accesos en la base del hero petróleo, bajo el titular: el correo con más peso y, debajo, teléfono y WhatsApp. */
  .contact-strip { grid-column: 1 / span 7; grid-row: 2; align-self: end; display: grid; grid-template-columns: 1fr 1fr; margin-top: 48px; border-top: 1px solid rgb(228 240 244 / 28%); }
  .contact-strip__item.contact-strip__item--mail { grid-column: 1 / -1; padding-bottom: 20px; border-bottom: 1px solid rgb(228 240 244 / 28%); }
  .contact-strip__item { display: grid; align-content: start; gap: 6px; min-width: 0; padding: 20px 24px 0 0; }
  .contact-strip__item + .contact-strip__item + .contact-strip__item { padding-left: 24px; border-left: 1px solid rgb(228 240 244 / 28%); }
  .contact-strip__item > p { display: flex; align-items: center; gap: 8px; margin: 0; color: var(--tint); font-size: 12px; font-weight: 700; letter-spacing: .1em; line-height: 1.4; text-transform: uppercase; }
  .contact-strip .icon, .contact-strip :global(.ui-icon) { flex: none; width: 18px; height: 18px; fill: none; stroke: currentColor; stroke-width: 1.7; }
  .contact-strip a { width: fit-content; max-width: 100%; color: #fff; font-size: 22px; font-weight: 600; line-height: 1.3; letter-spacing: -.01em; overflow-wrap: anywhere; text-decoration: underline; text-decoration-color: rgb(228 240 244 / 45%); text-underline-offset: 5px; }
  .contact-strip__item--mail a { font-size: clamp(22px, 2.4vw, 30px); }
  .contact-strip a:hover { text-decoration-color: #fff; }
  .contact-strip a:focus-visible { outline: 3px solid #fff; outline-offset: 4px; }
  .contact-strip :global(.whatsapp-access__inline) { display: contents; }
  .contact-strip :global(.whatsapp-access__inline a) { color: #fff; font-size: 22px; }
  @container (max-width: 767px) {
    .contact-strip { margin-top: 24px; }
    .contact-strip__item { padding: 12px 12px 0 0; gap: 2px; }
    .contact-strip__item.contact-strip__item--mail { padding-bottom: 12px; }
    .contact-strip__item + .contact-strip__item + .contact-strip__item { padding-left: 16px; }
    .contact-strip a, .contact-strip :global(.whatsapp-access__inline a) { font-size: 18px; white-space: nowrap; }
    .contact-strip__item--mail a { font-size: 19px; white-space: normal; }
  }
  @container (max-width: 1000px) {
    .contact-strip { grid-column: 1 / -1; grid-row: 2; }
  }
  @container (max-width: 359px) {
    .contact-strip a, .contact-strip :global(.whatsapp-access__inline a) { font-size: 16px; }
    .contact-strip__item--mail a { font-size: 16px; }
    .contact-strip__item + .contact-strip__item + .contact-strip__item { padding-left: 12px; }
  }
</style>
