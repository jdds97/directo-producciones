---
import review from '../../content/m3-review.json';
import { pageHref } from '../../lib/site-navigation';
const copy = review.home;
const headlineLines = copy.heading.split(/(?<=\.)\s+/);
const lines = [
  { heading: copy.streamingHeading, paragraph: copy.streamingParagraph, cta: copy.streamingCta, href: pageHref('produccion') + '#eventos' },
  { heading: copy.communicationHeading, paragraph: copy.communicationParagraph, cta: copy.communicationCta, href: pageHref('comunicacion') },
];
---
<div class="review-home">
  <section class="hero">
    <div class="hero-intro pad">
      <div class="hero-main" data-enter="0"><p class="eyebrow"><span class="rule"></span>{copy.eyebrow}</p><h1>{headlineLines.map((line, index) => <span>{line}{index < headlineLines.length - 1 ? " " : ""}</span>)}</h1></div>
      <div class="hero-copy" data-enter="80"><p>{copy.paragraph}</p><div class="review-hero-actions">{lines.map(line => <a class="button primary" href={line.href}>{line.cta}<svg class="icon arrow" aria-hidden="true" viewBox="0 0 24 24"><path d="M7 17 17 7M7 7h10v10" /></svg></a>)}</div></div>
    </div>
  </section>
  <section class="review-lines pad section" aria-label="Líneas de actividad">
    {lines.map(line => <article><h2>{line.heading}</h2><p>{line.paragraph}</p><a class="text-link" href={line.href}>{line.cta}<svg class="icon arrow" aria-hidden="true" viewBox="0 0 24 24"><path d="M7 17 17 7M7 7h10v10" /></svg></a></article>)}
  </section>
</div>
